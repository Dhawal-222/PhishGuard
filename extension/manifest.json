{"manifest_version":3,"name":"PhishGuard Link Shield","version":"1.0",
"description":"Warns you before you open suspicious links.",
"permissions":[],"host_permissions":["http://127.0.0.1:8000/*","http://localhost:8000/*"],
"background":{"service_worker":"background.js"},
"content_scripts":[{"matches":["<all_urls>"],"js":["content.js"],"run_at":"document_idle"}]}
